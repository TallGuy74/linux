/*
 * Luckfox Lyra PLC: RK3506B DIN-rail controller with a 1.9" ST7789V SPI panel and CST816S touch,
 * two RMII Ethernet ports, RS232 (UART1), RS485/RS422 (UART2), CAN, two relays, PCF8563 RTC and
 * an SHTC3 humidity sensor. The PoE and non-PoE variants are identical to software.
 */

/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include <dt-bindings/pwm/pwm.h>
#include "rk3506.dtsi"

/ {
	model = "Luckfox Lyra PLC";
	compatible = "luckfox,lyra-plc", "rockchip,rk3506";

	aliases {
		ethernet0 = &gmac0;
		ethernet1 = &gmac1;
		mmc0 = &sdmmc;
	};

	chosen {
		stdout-path = "serial0:1500000n8";
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x20000000>;
	};

	adc-keys {
		compatible = "adc-keys";
		io-channels = <&saradc 1>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt = <1800000>;
		poll-interval = <100>;

		button-user {
			label = "USER";
			linux,code = <KEY_VENDOR>;
			press-threshold-microvolt = <0>;
		};
	};

	/*
	 * GPIO1_C5 is the power enable of the AIC8800DC Wi-Fi/BT module (the
	 * vendor tree calls it BT,power_gpio and lets rfkill raise it; the chip
	 * only shows up on the USB hub once it is high). Described as the
	 * module's supply, switched by the onboard USB device driver from the
	 * hub's port node below; the module carries both radios, so this one
	 * rail cuts Bluetooth too.
	 */
	vcc_wifi: regulator-wifi {
		compatible = "regulator-fixed";
		regulator-name = "vcc_wifi";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio1 RK_PC5 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <100000>;
		vin-supply = <&vcc_3v3>;
	};

	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm0_4ch_2 0 25000 PWM_POLARITY_INVERTED>;
		brightness-levels = <0 20 40 60 80 100 120 140 160 180 200 220 240 255>;
		default-brightness-level = <10>;
		power-supply = <&vcc_3v3>;
	};

	leds {
		compatible = "gpio-leds";

		led-0 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_HEARTBEAT;
			gpios = <&gpio1 RK_PA0 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "heartbeat";
		};
	};

	vcc_sys: regulator-vcc-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
	};

	vcc_3v3: regulator-vcc-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_3v3";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc_sys>;
	};

	vcc_1v8: regulator-vcc-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_1v8";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&vcc_3v3>;
	};

	/*
	 * The core voltage is a PWM-driven buck: pwm0 channel 0 on RM_IO21,
	 * 5 us period, inverted. U-Boot sets it up; Linux keeps the PWM
	 * running and leaves the voltage alone until an OPP table asks for
	 * more.
	 */
	vdd_cpu: regulator-vdd-cpu {
		compatible = "pwm-regulator";
		pwms = <&pwm0_4ch_0 0 5000 PWM_POLARITY_INVERTED>;
		regulator-name = "vdd_cpu";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <710000>;
		regulator-max-microvolt = <1207000>;
		vin-supply = <&vcc_sys>;
	};
};

/* CAN0 on RM_IO12/13; 120 ohm termination by switch on the terminal block. */
&can0 {
	assigned-clocks = <&cru CLK_CAN0>;
	assigned-clock-rates = <200000000>;
	pinctrl-names = "default";
	pinctrl-0 = <&rm_io12_can0_tx>, <&rm_io13_can0_rx>;
	status = "okay";
};

&cpu0 {
	cpu-supply = <&vdd_cpu>;
};

&cpu1 {
	cpu-supply = <&vdd_cpu>;
};

&cpu2 {
	cpu-supply = <&vdd_cpu>;
};

&gmac0 {
	assigned-clocks = <&cru CLK_MAC_OUT>;
	assigned-clock-rates = <25000000>;
	clock_in_out = "output";
	phy-handle = <&rmii_phy0>;
	phy-mode = "rmii";
	pinctrl-names = "default";
	pinctrl-0 = <&eth_clk0_25m_out_pins>, <&eth_rmii0_miim_pins>, <&eth_rmii0_tx_bus2_pins>,
		    <&eth_rmii0_rx_bus2_pins>, <&eth_rmii0_clk_pins>;
	status = "okay";
};

&mdio0 {
	rmii_phy0: ethernet-phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <1>;
		clocks = <&cru CLK_MAC_OUT>;
		reset-gpios = <&gpio1 RK_PC0 GPIO_ACTIVE_LOW>;
		reset-assert-us = <20000>;
		reset-deassert-us = <100000>;
	};
};

&gmac1 {
	assigned-clocks = <&cru CLK_MAC_OUT>;
	assigned-clock-rates = <25000000>;
	clock_in_out = "output";
	phy-handle = <&rmii_phy1>;
	phy-mode = "rmii";
	pinctrl-names = "default";
	pinctrl-0 = <&eth_clk1_25m_out_pins>, <&eth_rmii1_miim_pins>, <&eth_rmii1_tx_bus2_pins>,
		    <&eth_rmii1_rx_bus2_pins>, <&eth_rmii1_clk_pins>;
	status = "okay";
};

&mdio1 {
	rmii_phy1: ethernet-phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <1>;
		clocks = <&cru CLK_MAC_OUT>;
		reset-gpios = <&gpio1 RK_PC1 GPIO_ACTIVE_HIGH>;
		reset-assert-us = <20000>;
		reset-deassert-us = <100000>;
	};
};

&gpio0 {
	gpio-line-names =
		"lcd-reset", "", "lcd-dc", "", "", "", "touch-reset", "touch-irq",
		"", "", "", "", "", "", "", "rs485-txen",
		"", "relay0", "relay1", "", "", "", "", "",
		"", "", "", "", "", "", "", "";
};

/* External I2C header */
&i2c0 {
	pinctrl-names = "default";
	pinctrl-0 = <&rm_io30_i2c0_scl>, <&rm_io31_i2c0_sda>;
	status = "okay";
};

&i2c1 {
	pinctrl-names = "default";
	pinctrl-0 = <&rm_io9_i2c1_scl>, <&rm_io8_i2c1_sda>;
	status = "okay";

	touchscreen@15 {
		compatible = "hynitron,cst816s";
		reg = <0x15>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PA7 IRQ_TYPE_EDGE_FALLING>;
		reset-gpios = <&gpio0 RK_PA6 GPIO_ACTIVE_LOW>;
	};
};

&i2c2 {
	pinctrl-names = "default";
	pinctrl-0 = <&rm_io28_i2c2_scl>, <&rm_io29_i2c2_sda>;
	status = "okay";

	rtc@51 {
		compatible = "nxp,pcf8563";
		reg = <0x51>;
		#clock-cells = <0>;
	};

	humidity-sensor@70 {
		compatible = "sensirion,shtc3";
		reg = <0x70>;
	};
};

&pwm0_4ch_0 {
	pinctrl-names = "default";
	pinctrl-0 = <&rm_io21_pwm0_ch0>;
	status = "okay";
};

&pwm0_4ch_2 {
	pinctrl-names = "default";
	pinctrl-0 = <&rm_io5_pwm0_ch2>;
	status = "okay";
};

&saradc {
	vref-supply = <&vcc_1v8>;
	status = "okay";
};

/* 8 GB eMMC, 4-bit DDR52 as the vendor image runs it */
&sdmmc {
	bus-width = <4>;
	cap-mmc-highspeed;
	disable-wp;
	max-frequency = <52000000>;
	mmc-ddr-1_8v;
	no-sd;
	no-sdio;
	non-removable;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc_clk_pins>, <&sdmmc_cmd_pins>, <&sdmmc_bus4_pins>;
	vmmc-supply = <&vcc_3v3>;
	vqmmc-supply = <&vcc_1v8>;
	status = "okay";
};

/* 1.9" 170x320 ST7789V panel, fbtft */
&spi0 {
	pinctrl-names = "default";
	pinctrl-0 = <&rm_io1_spi0_clk>, <&rm_io4_spi0_mosi>, <&rm_io3_spi0_csn0>;
	status = "okay";

	display@0 {
		compatible = "sitronix,st7789v";
		reg = <0>;
		spi-max-frequency = <50000000>;
		power-supply = <&vcc_3v3>;
		backlight = <&backlight>;
		/* fbtft (staging) properties; the sitronix,st7789v panel schema does not know them */
		buswidth = <8>;
		fps = <60>;
		/* 1.9" 170x320 glass at columns 35..204 of the controller's 240x320 RAM */
		width = <170>;
		height = <320>;
		col-offset = <35>;
		/* 170x320 glass mounted landscape: rotate the framebuffer (degrees) */
		rotate = <270>;
		dc-gpios = <&gpio0 RK_PA2 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio0 RK_PA0 GPIO_ACTIVE_LOW>;
	};
};

&tsadc {
	status = "okay";
};

&uart0 {
	status = "okay";
};

/* RS232 */
&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&rm_io10_uart1_tx>, <&rm_io11_uart1_rx>;
	status = "okay";
};

/* RS485 / RS422, transmit enable on GPIO0_B7 driven from user space */
&uart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&rm_io14_uart2_tx>, <&rm_io16_uart2_rx>;
	status = "okay";
};

&u2phy {
	status = "okay";
};

&u2phy_otg0 {
	status = "okay";
};

&u2phy_otg1 {
	status = "okay";
};

&usb_otg0 {
	dr_mode = "peripheral";
	status = "okay";
};

&usb_otg1 {
	dr_mode = "host";
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	/* WCH CH334 four-port hub; the Wi-Fi/BT module hangs off its port 1 */
	hub_2_0: hub@1 {
		compatible = "usb1a86,8091";
		reg = <1>;
		vdd33-supply = <&vcc_3v3>;
		v5-supply = <&vcc_3v3>;
		#address-cells = <1>;
		#size-cells = <0>;

		wifi: wifi@1 {
			compatible = "usba69c,88dc";
			reg = <1>;
			vdd-supply = <&vcc_wifi>;
		};
	};
};

&wdt0 {
	status = "okay";
};

