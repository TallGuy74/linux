# Luckfox Lyra PLC on top of rk3506_minimal.config:
#   make ARCH=arm multi_v7_defconfig rk3506_minimal.config rk3506_plc.config
# Re-enables the subsystems the PLC's device tree drives.

# eMMC
CONFIG_MMC=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y

# USB: OTG0 is the USB-C port (peripheral), OTG1 hosts the hub with the Wi-Fi module and USB-A
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_DUAL_ROLE=y
CONFIG_PHY_ROCKCHIP_INNO_USB2=y
CONFIG_USB_STORAGE=y
CONFIG_USB_NET_DRIVERS=y

# Ethernet (RMII, two ports) and the PHYs
CONFIG_NET=y
CONFIG_STMMAC_ETH=y
CONFIG_DWMAC_ROCKCHIP=y
CONFIG_PHYLIB=y

# 1.9" ST7789V panel through fbtft, console on it
CONFIG_FB=y
CONFIG_FB_TFT=y
CONFIG_FB_TFT_ST7789V=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_SPI=y
CONFIG_SPI_ROCKCHIP=y

# Touch, button, LED
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_HYNITRON_CST816X=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ADC=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y

# I2C devices: RTC, humidity sensor
CONFIG_I2C=y
CONFIG_I2C_RK3X=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_PCF8563=y
CONFIG_HWMON=y
CONFIG_SENSORS_SHTC1=y

# ADC, thermal, watchdog, OTP
CONFIG_IIO=y
CONFIG_ROCKCHIP_SARADC=y
CONFIG_THERMAL=y
CONFIG_ROCKCHIP_THERMAL=y
CONFIG_WATCHDOG=y
CONFIG_DW_WATCHDOG=y
CONFIG_NVMEM=y
CONFIG_NVMEM_ROCKCHIP_OTP=y
# PWMv4 block (backlight on pwm0 ch2, core voltage on pwm0 ch0)
CONFIG_MFD_ROCKCHIP_MFPWM=y
CONFIG_PWM=y
CONFIG_PWM_ROCKCHIP_V4=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_REGULATOR_PWM=y
# cpufreq via the OPP table and the PWM core supply; thermal throttling; Wi-Fi module power switch
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_DEFAULT_GOV_ONDEMAND=y
CONFIG_CPUFREQ_DT=y
CONFIG_CPUFREQ_DT_PLATDEV=y
CONFIG_CPU_THERMAL=y
CONFIG_RFKILL=y
CONFIG_RFKILL_GPIO=y
# CAN0 (field bus) on the RK3576-type controller
CONFIG_CAN=m
CONFIG_CAN_RAW=m
CONFIG_CAN_BCM=m
CONFIG_CAN_DEV=m
CONFIG_CAN_CALC_BITTIMING=y
CONFIG_CAN_ROCKCHIP_RK3576=m
