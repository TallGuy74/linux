# Minimal RK3506 / Luckfox Lyra Plus config fragment.
#
# Usage, in-tree:
#   make ARCH=arm multi_v7_defconfig rk3506_minimal.config
#
# Usage, Buildroot:
#   BR2_LINUX_KERNEL_DEFCONFIG="multi_v7"
#   BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES=".../rk3506_minimal.config"
#
# Goal: reach a prompt on ttyS0 from an initramfs. Anything that is not
# needed to print on uart0 is turned off on purpose, so that no driver can
# fail to probe before the console is up.
#
# Every symbol below exists in the arch/arm Kconfig tree, so the fragment is
# safe to append to multi_v7_defconfig and run olddefconfig over.

CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_ROCKCHIP=y

# Clock and reset controller. CLK_RK3506 is "default y" and depends on
# "ARM || COMPILE_TEST" (drivers/clk/rockchip/Kconfig:103), so it would be
# picked up anyway; listed here to pin the intent.
CONFIG_COMMON_CLK_ROCKCHIP=y
CONFIG_CLK_RK3506=y

# Pin control and GPIO. Built in, not modular: the uart0 pinmux has to be
# applied before the console can be opened.
CONFIG_PINCTRL=y
CONFIG_PINCTRL_ROCKCHIP=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_ROCKCHIP=y

# Console
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON=y

# Timer, interrupt controller, PSCI (secondary CPU bring-up and reset)
CONFIG_ARM_ARCH_TIMER=y
CONFIG_ARM_GIC=y
CONFIG_ARM_PSCI=y
CONFIG_ARM_PSCI_FW=y

# ramoops: the only way to read a panic that happened before the console was
# up. Backed by reserved-memory ramoops@83000 in rk3506.dtsi.
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y

# Rootfs from initramfs
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Explicitly out of scope for a console-only bring-up: no node in the DT
# drives any of these, and each one is a probe that could run before the
# console is live.
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_SOUND is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_MMC is not set
# CONFIG_MTD is not set
