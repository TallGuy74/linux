config CAN_ROCKCHIP_CANFD
	tristate "Rockchip CAN-FD controller"
	depends on OF
	depends on ARCH_ROCKCHIP || COMPILE_TEST
	select CAN_RX_OFFLOAD
	help
	  Say Y here if you want to use CAN-FD controller found on
	  Rockchip SoCs.

config CAN_ROCKCHIP_RK3576
	tristate "Rockchip RK3576-type CAN controller (RK3576, RK3506, RV1126B)"
	depends on OF
	depends on ARCH_ROCKCHIP || COMPILE_TEST
	help
	  Say Y here if you want to use the CAN controller found on the
	  Rockchip RK3576, RK3506 and RV1126B SoCs (classic CAN; this is
	  not the RK3568/RK3588 CAN-FD block handled by CAN_ROCKCHIP_CANFD).
